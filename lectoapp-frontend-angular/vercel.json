{
  "version": 2,
  "buildCommand": "npm run build:prod",
  "outputDirectory": "dist/prod",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/(.*)\\.(js|css|woff2|woff|ttf|png|svg|jpg|jpeg|gif|webp|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(json|html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
